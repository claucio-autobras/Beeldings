PORT=4000

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx

# Database (Prisma)
# DEV: Postgres local (docker-compose.test.yml). Use este valor em desenvolvimento.
DATABASE_URL=postgresql://postgres:bluebee123@localhost:5432/bluebee
#
# PRODUÇÃO: NÃO escreva a senha real neste arquivo. Defina DATABASE_URL como
# variável de ambiente no próprio host (systemd Environment=, PM2 ecosystem,
# env do container ou painel de secrets do provedor). O ConfigModule do NestJS
# usa dotenv, que NÃO sobrescreve variáveis já presentes no ambiente — então a
# variável definida no host prevalece sobre o .env, sem precisar editar arquivo.
# Atenção: caracteres especiais na senha precisam ser URL-encoded:
#   @ -> %40   : -> %3A   / -> %2F   (ex.: "Bluebee@2026" vira "Bluebee%402026")
# Formato: postgresql://USUARIO:SENHA_ENCODED@HOST:5432/postgres

# JWT — gere um segredo forte e único: `openssl rand -base64 48`
# (ou node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# MQTT — conexão do backend com o broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=backend-bluebee-01
MQTT_USERNAME=backend-bluebee-01
MQTT_PASSWORD=change-me

# MQTT — URL que será gravada no gateway-config.env gerado pela plataforma
MQTT_GATEWAY_BROKER_URL=mqtt://localhost:1883

# EMQX Management API (provisionamento de credenciais por gateway)
# EMQX 5.x usa API Keys (não username/password do dashboard)
# Crie em: http://localhost:18083 > System > API Keys > Create
# Deixe EMQX_API_URL vazio para desabilitar provisionamento automático
EMQX_API_URL=http://localhost:18083/api/v5
EMQX_API_KEY=your-api-key-id
EMQX_API_SECRET=your-api-key-secret

# Infraspeak REST API (integração SOMENTE LEITURA dos "chamados do negócio")
# Documentação oficial: https://infraspeak.stoplight.io/docs/api
# Relatório técnico interno: docs/infraspeak-requirements-api.md
#
# OBRIGATÓRIAS:
#   INFRASPEAK_API_BASE_URL — URL base da API. A doc oficial usa o placeholder
#     "<API base URL>" e NÃO declara o host; confirme o valor com a Infraspeak
#     (ambiente sandbox/produção). Sem barra final. Ex.: https://<host>
#   INFRASPEAK_API_TOKEN — Personal Access Token (PAT) Bearer, obtido por contato
#     direto com a Infraspeak (não há geração self-service). Trate como senha.
#   INFRASPEAK_REQUESTS_PATH — caminho do recurso dos chamados, a confirmar na doc
#     oficial (página do recurso exige login no Stoplight). Ex.: v3/<recurso>
INFRASPEAK_API_BASE_URL=
INFRASPEAK_API_TOKEN=
INFRASPEAK_REQUESTS_PATH=
#
# OPCIONAIS (têm valores padrão sensatos):
# INFRASPEAK_USER_AGENT=Bluebee-IoT Infraspeak Integration (contato@exemplo.com)
# INFRASPEAK_TIMEOUT_MS=15000
# INFRASPEAK_MAX_RETRIES=3
# INFRASPEAK_PAGE_LIMIT=200
# INFRASPEAK_MAX_PAGES=1000
