# Gateway BlueBee IoT — variáveis de ambiente
# Copie para .env e ajuste os valores para o ambiente local

# Porta HTTP do gateway (NestJS)
PORT=3001

# Broker MQTT (EMQX)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Identificação do gateway (gerados automaticamente pela plataforma ao criar o Site)
GATEWAY_ID=gw-01
TENANT_ID=default
MQTT_CLIENT_ID=gateway-gw-01

# Resumo de saúde do gateway (fila offline, reconexões MQTT, latência de polling)
# publicado periodicamente em bluebee/{tenant}/gateway/{id}/health para a tela de
# Gateway. Aditivo e isolado: não afeta telemetria nem o status de liveness.
# GATEWAY_HEALTH_ENABLED=false  # desliga a publicação do resumo de saúde
# GATEWAY_HEALTH_INTERVAL_MS=20000  # intervalo de publicação (piso de 5000ms)
