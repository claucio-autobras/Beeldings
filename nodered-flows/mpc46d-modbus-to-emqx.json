[
  {
    "id": "tab-modbus",
    "type": "tab",
    "label": "MPC46D Modbus → EMQX",
    "disabled": false,
    "info": "Leitura Modbus TCP do MPC46D → publica no EMQX formato BlueBee.\nDI1-DI4 = registradores 20000-20003 (WORD)\nDO1-DO2 = registradores 20200-20201 (WORD R/W)"
