    "logIOActivities": false,
    "showErrors": false,
    "unitid": "",
    "dataType": "HoldingRegister",
    "adr": "200",
    "quantity": "2",
    "rate": "10",
    "rateUnit": "s",
    "delayOnStart": false,
    "startDelayTime": "",
    "server": "modbus-client",
    "useIOFile": false,
    "ioFile": "",
    "useIOForPayload": false,
    "emptyMsgOnFail": false,
    "x": 330,
    "y": 260,
    "wires": [["fn-do"], ["debug-erro"]]
  },

  {
    "id": "fn-do",
    "type": "function",
    "z": "tab-modbus",
    "name": "Formatar DO1-DO2",
    "func": "// data[0]=DO1 (CMD_CHILLER_1), data[1]=DO2 (CMD_CHILLER_2)\n// Offset 200 = endereço 20200 (base-0)\nconst d = msg.payload.data || msg.payload;\nif (!d || !d.length) return null;\n\nconst tags = ['CMD_CHILLER_1','CMD_CHILLER_2'];\nconst points = tags.map((tag, i) => ({\n  tag,\n  value: d[i] === 1,\n  unit: null,\n  quality: 'good'\n}));\n\nmsg.topic   = 'bluebee/tenant-teste/devices/mpc46d-01/telemetry';\nmsg.payload = JSON.stringify({\n  device_id: 'mpc46d-01',\n  tenant_id: 'tenant-teste',\n  timestamp: new Date().toISOString(),\n  protocol:  'modbus',\n  points\n});\nreturn msg;",
    "outputs": 1,
    "x": 580,
    "y": 260,
    "wires": [["mqtt-out", "debug-ok"]]
  }
]
