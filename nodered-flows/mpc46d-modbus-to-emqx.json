    "name": "MPC46D Modbus TCP | IP: 10.201.10.11:502 | Base: 20000 | EMQX: emqx:1883",
    "info": "DI_01=20000, DI_02=20001, DI_03=20002, DI_04=20003\nDO_01=20200, DO_02=20201",
