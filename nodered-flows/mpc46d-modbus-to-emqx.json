    "wires": [["modbus-read-di"]]
  },

  {
    "id": "modbus-read-di",
    "type": "modbus-read",
    "z": "tab-modbus",
    "name": "Ler DI1-DI4",
    "topic": "",
    "showStatusActivities": false,
    "logIOActivities": false,
    "showErrors": false,
    "unitid": "",
    "dataType": "HoldingRegister",
    "adr": "0",
    "quantity": "4",
    "rate": "10",
    "rateUnit": "s",
    "delayOnStart": false,
    "startDelayTime": "",
    "server": "modbus-client",
    "useIOFile": false,
    "ioFile": "",
    "useIOForPayload": false,
    "emptyMsgOnFail": false,
    "x": 330,
    "y": 140,
    "wires": [["fn-di"], ["debug-erro"]]
  },

  {
    "id": "fn-di",
    "type": "function",
    "z": "tab-modbus",
    "name": "Formatar DI1-DI4",
    "func": "// data[0]=DI1, data[1]=DI2, data[2]=DI3, data[3]=DI4\n// Offset 0 = endereço 20000 (modbus-serial base-0)\nconst d = msg.payload.data || msg.payload;\nif (!d || !d.length) return null;\n\nconst tags = ['FALHA_BOMBA_1','FALHA_BOMBA_2','FALHA_CHILLER_1','FALHA_CHILLER_2'];\nconst points = tags.map((tag, i) => ({\n  tag,\n  value: d[i] === 1,\n  unit: null,\n  quality: 'good'\n}));\n\nmsg.topic   = 'bluebee/tenant-teste/devices/mpc46d-01/telemetry';\nmsg.payload = JSON.stringify({\n  device_id: 'mpc46d-01',\n  tenant_id: 'tenant-teste',\n  timestamp: new Date().toISOString(),\n  protocol:  'modbus',\n  points\n});\nreturn msg;",
    "outputs": 1,
    "x": 580,
    "y": 140,
    "wires": [["mqtt-out", "debug-ok"]]
  },

  {
    "id": "inject-do",
    "type": "inject",
    "z": "tab-modbus",
    "name": "Polling DO 10s",
    "props": [{"p": "payload"}],
    "repeat": "10",
    "crontab": "",
    "once": true,
    "onceDelay": "5",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 110,
