  },

  {
    "id": "modbus-read-tensao",
    "type": "modbus-read",
    "z": "tab-modbus-analog",
    "name": "Ler reg 10 — Tensão Fase A",
    "topic": "",
    "showStatusActivities": false,
    "logIOActivities": false,
    "showErrors": false,
    "unitid": "1",
    "dataType": "HoldingRegister",
    "adr": "10",
    "quantity": "1",
    "rate": "10",
    "rateUnit": "s",
    "delayOnStart": false,
    "startDelayTime": "",
    "server": "modbus-client-analog",
    "useIOFile": false,
    "ioFile": "",
    "useIOForPayload": false,
    "emptyMsgOnFail": false,
    "x": 330,
    "y": 140,
    "wires": [["fn-tensao", "debug-analog-raw"], ["debug-analog-erro"]]
  },

  {
    "id": "fn-tensao",
    "type": "function",
    "z": "tab-modbus-analog",
    "name": "→ TENSAO_FASE_A",
    "func": "const d = msg.payload.data || msg.payload;\nif (!d || !d.length) return null;\n\n// Valor raw UINT16 — ajustar fator de escala conforme documentação do medidor\n// Exemplo: se o medidor retorna 2200 = 220.0 V, dividir por 10\nconst rawValue = d[0];\nconst value = rawValue; // Ajustar escala aqui se necessário\n\nmsg.topic   = 'bluebee/tenant-teste/devices/mpc46d-01/telemetry';\nmsg.payload = JSON.stringify({\n  device_id: 'mpc46d-01',\n  tenant_id: 'tenant-teste',\n  timestamp: new Date().toISOString(),\n  protocol:  'modbus',\n  points: [{\n    tag:     'TENSAO_FASE_A',\n    value:   value,\n    unit:    'V',\n    quality: 'good'\n  }]\n});\nreturn msg;",
    "outputs": 1,
    "x": 600,
    "y": 140,
    "wires": [["mqtt-out-analog", "debug-analog-ok"]]
  },

